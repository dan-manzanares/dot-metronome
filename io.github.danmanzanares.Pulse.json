{
    "app-id": "io.github.danmanzanares.Pulse",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "pulse",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri"
    ],
    "modules": [
        {
            "name": "pulse",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm644 -t /app/share/pulse main_gtk.py interfaz.py motor.py estado.py sonido.py rutas.py estilo.css README.md",
                "install -Dm644 -t /app/share/pulse/resources resources/*.mp3 resources/*.wav",
                "install -Dm755 pulse.sh /app/bin/pulse",
                "install -Dm644 packaging/io.github.danmanzanares.Pulse.desktop /app/share/applications/io.github.danmanzanares.Pulse.desktop",
                "install -Dm644 packaging/io.github.danmanzanares.Pulse.metainfo.xml /app/share/metainfo/io.github.danmanzanares.Pulse.metainfo.xml",
                "install -Dm644 packaging/io.github.danmanzanares.Pulse.svg /app/share/icons/hicolor/scalable/apps/io.github.danmanzanares.Pulse.svg"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/dan-manzanares/pulse.git",
                    "tag": "v1.0.0",
                    "commit": "4b7a66ed9a657db9b25d147ab426bb4533694afc"
                }
            ]
        }
    ]
}
