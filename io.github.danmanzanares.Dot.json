{
    "app-id": "io.github.danmanzanares.Dot",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "dot",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri"
    ],
    "modules": [
        {
            "name": "dot",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm644 -t /app/share/dot main_gtk.py interfaz.py motor.py estado.py sonido.py rutas.py estilo.css README.md",
                "find resources -type f ! -name '*.png' -exec install -Dm644 -t /app/share/dot/resources {} +",
                "install -Dm755 dot.sh /app/bin/dot",
                "install -Dm644 packaging/io.github.danmanzanares.Dot.desktop /app/share/applications/io.github.danmanzanares.Dot.desktop",
                "install -Dm644 packaging/io.github.danmanzanares.Dot.metainfo.xml /app/share/metainfo/io.github.danmanzanares.Dot.metainfo.xml",
                "install -Dm644 packaging/io.github.danmanzanares.Dot.svg /app/share/icons/hicolor/scalable/apps/io.github.danmanzanares.Dot.svg"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/dan-manzanares/dot-metronome.git",
                    "tag": "v1.0.0",
                    "commit": "4b7a66ed9a657db9b25d147ab426bb4533694afc"
                }
            ]
        }
    ]
}
