<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.danmanzanares.Dot</id>
  <metadata_license>CC0-1.0</metadata_license>
  <!-- La app no declara una licencia de código aparte; el diálogo "Acerca de"
       (ver interfaz.py) muestra CC BY-NC 4.0, igual que LICENSE.md, así que
       se refleja igual acá. Si más adelante se define otra licencia,
       actualizar los tres lugares. -->
  <project_license>CC-BY-NC-4.0</project_license>
  <name>Dot</name>
  <summary>Metrónomo minimalista, con subdivisiones, sin anuncios ni rastreo</summary>
  <developer id="io.github.danmanzanares">
    <name>Daniel Alejandro Manzanares Chichil</name>
  </developer>
  <!-- Nota: el linter de Flathub (flatpak-builder-lint) NO lee esta etiqueta
       para verificar propiedad del App ID — arma su propia URL a partir del
       texto del App ID (github.com/danmanzanares/dot, sin guion y sin el
       sufijo "-metronome") y esa comprobación va a fallar en 404 por dos
       motivos: un guion no es válido en un segmento no-final de un App ID
       (ver nota en main_gtk.py), y el repo real se llama "dot-metronome"
       (no solo "dot", porque "dot" a secas ya podía chocar con otro proyecto
       en GitHub). El usuario real de GitHub sí lleva guion. Por eso, aquí
       abajo, el homepage apunta a la URL real para que los usuarios lleguen
       al repo correcto; hay que pedirle al revisor de Flathub que verifique
       la propiedad a mano. -->
  <url type="homepage">https://github.com/dan-manzanares/dot-metronome</url>
  <url type="donation">https://buymeacoffee.com/daniel_manzanares</url>
  <description>
    <p>
      Metrónomo de escritorio pensado para practicar: un círculo se ilumina
      en cada beat, y otro más pequeño en cada subdivisión, con sonidos
      independientes para el primer beat, los beats y las subdivisiones.
    </p>
    <p>Sin anuncios, sin rastreo, sin pedidos de actualizar a premium.</p>
  </description>
  <launchable type="desktop-id">io.github.danmanzanares.Dot.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <caption>Pantalla principal: BPM, círculo de beat/subdivisión y selector de subdivisión</caption>
      <image>https://raw.githubusercontent.com/dan-manzanares/dot-metronome/main/resources/screenshot.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="1.0" date="2026-09-14">
      <description>
        <p>Primera versión empaquetada como Flatpak.</p>
      </description>
    </release>
  </releases>
</component>
